---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import DownloadCTA from '../components/DownloadCTA.astro';

const installURL = 'https://chromewebstore.google.com/detail/gpgmeejjkhbmepdcffeooijjjdbbdikg?utm_source=item-share-cb';
const githubURL = 'https://github.com/griffincockfoster56/ai-twitter-filter';

const steps = [
  {
    title: 'Install the extension',
    desc: 'Add AI Twitter Filter to Chrome from the Web Store — free and open source.',
  },
  {
    title: 'Add your API key',
    desc: 'Bring your own OpenAI or OpenRouter key. It is stored only on your device.',
  },
  {
    title: 'Set your filter prompt',
    desc: 'Describe what you never want to see again, and scroll a cleaner timeline.',
  },
];

const features = [
  {
    title: 'AI-Powered Filtering',
    desc: 'Every tweet is evaluated in real time against your own criteria — not a keyword blocklist.',
    icon: 'M12 2l2.4 7.6H22l-6.2 4.5 2.4 7.5-6.2-4.5-6.2 4.5 2.4-7.5L2 9.6h7.6z',
  },
  {
    title: 'Fully Custom Prompts',
    desc: 'Hide negativity, crypto spam, rage-bait, spoilers — anything you can describe in a sentence.',
    icon: 'M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z',
  },
  {
    title: 'Multi-Model Support',
    desc: 'Works with OpenAI and OpenRouter — GPT, Gemini, Claude, DeepSeek, Llama and more.',
    icon: 'M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z',
  },
  {
    title: 'Real-Time Timeline',
    desc: 'New tweets are checked as you scroll. Requests are batched and cached to keep costs down.',
    icon: 'M12 6a6 6 0 0 1 6 6h-2l3 4 3-4h-2a8 8 0 1 0-16 0h2a6 6 0 0 1 6-6zm-9 8a2 2 0 1 0 2-2 2 2 0 0 0-2 2zm18 0a2 2 0 1 0-2-2 2 2 0 0 0 2 2z',
  },
  {
    title: 'Private by Design',
    desc: 'No servers, no analytics, no tracking. Your key and filtering history never leave your browser.',
    icon: 'M12 1l9 4v6c0 5.55-3.84 10.74-9 12-5.16-1.26-9-6.45-9-12V5l9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v9.8z',
  },
  {
    title: 'Saved Filter Presets',
    desc: 'Save your favorite prompts and switch between them instantly from the popup.',
    icon: 'M17 3H7a2 2 0 0 0-2 2v16l7-3 7 3V5a2 2 0 0 0-2-2z',
  },
];
---

<Layout>
  <nav class="nav">
    <div class="container nav-inner">
      <a href="/" class="brand">
        <img src="/favicon.png" alt="AI Twitter Filter logo" width="28" height="28" />
        <span>AI Twitter Filter</span>
      </a>
      <div class="nav-links">
        <a href="#how-it-works">How it works</a>
        <a href="#features">Features</a>
        <a href={githubURL} target="_blank" rel="noopener">GitHub</a>
        <a href={installURL} target="_blank" rel="noopener" class="btn btn-primary btn-sm">Add to Chrome</a>
      </div>
    </div>
  </nav>

  <Hero />

  <section id="how-it-works" class="section">
    <div class="container">
      <h2 class="section-title">How it <span class="accent">works</span></h2>
      <div class="steps">
        {steps.map((step, i) => (
          <div class="step-card">
            <div class="step-num">{i + 1}</div>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="features" class="section section-alt">
    <div class="container">
      <h2 class="section-title">Everything you need for a <span class="accent">cleaner feed</span></h2>
      <div class="features">
        {features.map((feature) => (
          <div class="feature-card">
            <div class="feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d={feature.icon} /></svg>
            </div>
            <h3>{feature.title}</h3>
            <p>{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="screenshots" class="section">
    <div class="container">
      <h2 class="section-title">See it in <span class="accent">action</span></h2>
      <div class="screenshots">
        <figure>
          <img src="/assets/screenshots/screenshot-2-filtering.png" alt="Tweets being checked by the AI filter in real time" loading="lazy" />
          <figcaption>Each new tweet is checked as it appears</figcaption>
        </figure>
        <figure>
          <img src="/assets/screenshots/screenshot-3-filtered.png" alt="Filtered tweets collapsed with a reason and a Show button" loading="lazy" />
          <figcaption>Hidden tweets collapse with a reason — and can be revealed</figcaption>
        </figure>
        <figure>
          <img src="/assets/screenshots/screenshot-4-features.png" alt="The extension popup with custom filter settings" loading="lazy" />
          <figcaption>Custom prompts, model choice and saved presets</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <DownloadCTA />

  <footer class="footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <span>AI Twitter Filter</span>
        <p>Open-source AI filtering for your X.com timeline.</p>
      </div>
      <div class="footer-links">
        <a href={githubURL} target="_blank" rel="noopener">GitHub</a>
        <a href={installURL} target="_blank" rel="noopener">Chrome Web Store</a>
      </div>
    </div>
    <div class="container footer-bottom">
      <p>© 2026 AI Twitter Filter. Not affiliated with X Corp.</p>
    </div>
  </footer>
</Layout>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 17px;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
  }
  .nav-links a:hover {
    color: var(--text-primary);
  }
  .btn-sm {
    padding: 8px 18px;
    font-size: 13px;
    color: #fff;
  }

  .section {
    padding: 90px 0;
    position: relative;
  }
  .section-alt {
    background: var(--bg-secondary);
  }
  .section-title {
    font-size: 38px;
    font-weight: 800;
    letter-spacing: -0.5px;
    text-align: center;
    margin-bottom: 56px;
  }
  .accent {
    color: var(--accent);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .step-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 32px 28px;
  }
  .step-num {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
  }
  .step-card h3 {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 10px;
  }
  .step-card p {
    color: var(--text-secondary);
    font-size: 15px;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .feature-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 28px;
  }
  .feature-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--accent-bg);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
  }
  .feature-card h3 {
    font-size: 17px;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .feature-card p {
    color: var(--text-secondary);
    font-size: 14px;
  }

  .screenshots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .screenshots figure {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .screenshots img {
    border-radius: 12px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1), 0 0 0 1px rgba(0, 0, 0, 0.05);
  }
  .screenshots figcaption {
    text-align: center;
    font-size: 14px;
    color: var(--text-secondary);
  }

  .footer {
    border-top: 1px solid var(--border);
    padding: 48px 0 32px;
  }
  .footer-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }
  .footer-brand span {
    font-weight: 800;
    font-size: 16px;
  }
  .footer-brand p {
    color: var(--text-secondary);
    font-size: 14px;
    margin-top: 6px;
  }
  .footer-links {
    display: flex;
    gap: 20px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
  }
  .footer-links a:hover {
    color: var(--text-primary);
  }
  .footer-bottom {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .footer-bottom p {
    font-size: 13px;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .steps,
    .features,
    .screenshots {
      grid-template-columns: 1fr;
    }
    .section-title {
      font-size: 28px;
    }
    .nav-links a:not(.btn) {
      display: none;
    }
  }
</style>
